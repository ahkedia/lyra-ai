[Unit]
Description=Lyra PWA API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lyra
WorkingDirectory=/opt/lyra-ai
EnvironmentFile=/etc/lyra/lyra-app.env
ExecStart=/usr/bin/node /opt/lyra-ai/app/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lyra-app

[Install]
WantedBy=multi-user.target
