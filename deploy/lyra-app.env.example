NODE_ENV=production
LYRA_APP_PORT=8787
LYRA_APP_TOKEN=replace-with-a-long-random-bootstrap-token
LYRA_DATABASE_URL=postgres://lyra:replace-me@127.0.0.1:5432/lyra
LYRA_APP_DATA_DIR=/var/lib/lyra-app
LYRA_RP_ID=lyra.example.com
LYRA_ORIGIN=https://lyra.example.com
LYRA_PWA_V2=0
LYRA_CRON_INGEST_V2=0
LYRA_FALLBACK_TELEGRAM=1
LYRA_FALLBACK_WHATSAPP=1
LYRA_CRON_TOKEN=replace-with-a-separate-long-random-cron-token

# Trusted Today sources (enable only what is configured on the host)
NOTION_API_KEY=
NOTION_REMINDERS_DS_ID=
LYRA_ENABLE_CALENDAR=0
LYRA_ENABLE_EMAIL=0
LYRA_TODAY_SNAPSHOT=
LYRA_SOURCE_TIMEOUT_MS=1800

# Voice transcription (optional)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Web Push (required for alerts)
LYRA_VAPID_PUBLIC_KEY=
LYRA_VAPID_PRIVATE_KEY=
LYRA_VAPID_SUBJECT=mailto:you@example.com

# WhatsApp shared-channel fallback (configure on the webhook process)
# LYRA_APP_URL=https://lyra.example.com
# LYRA_APP_TOKEN=the-same-bootstrap-token

# Telegram shared-channel bridge (disable native OpenClaw Telegram polling first)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWLIST=
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_BRIDGE_STATE=/var/lib/lyra-app/telegram-offset.json
