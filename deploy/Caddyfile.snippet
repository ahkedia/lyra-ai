wa.akashkedia.com {
  encode gzip

  redir /app /app/ 308

  # New PWA at the existing Telegram Mini App URL. Strip the public prefix so
  # the Node server can keep its normal root/static and /v1 API contract.
  handle /app/* {
    uri strip_prefix /app
    reverse_proxy 127.0.0.1:8787
    header {
      X-Content-Type-Options "nosniff"
      Referrer-Policy "same-origin"
    }
  }
  @pwa path /health /v1* /styles.css /app.js /auth.js /sw.js /manifest.webmanifest /icon.svg
  handle @pwa {
    reverse_proxy 127.0.0.1:8787
    header {
      Strict-Transport-Security "max-age=31536000; includeSubDomains"
      X-Content-Type-Options "nosniff"
      X-Frame-Options "DENY"
      Referrer-Policy "same-origin"
    }
  }

  # The legacy Telegram Mini App and WhatsApp webhook are retired.
  # Keep unknown paths closed rather than proxying them to dormant services.
  handle { respond "Not found" 404 }
}
